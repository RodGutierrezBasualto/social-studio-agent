# Template for .env. Copy to .env and fill in.
#
# Infrastructure only. Provider API keys (text model, image model, Buffer,
# Firecrawl, ScrapeCreators, Unipile, Slack) are NOT set here — they are entered
# per workspace in the app at Settings → Connections and stored encrypted in the
# database.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Run `npm run db:start` first; then `supabase status` prints the publishable
# and secret (service role) keys. Paste them below — VITE_SUPABASE_PUBLISHABLE_KEY
# is the same value as SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
#
# PROVIDER_KEY_SECRET encrypts saved provider API keys at rest. Changing it
# makes every already-saved key undecryptable — keep it stable.
PROVIDER_KEY_SECRET=""
CRON_TICK_SECRET=""
UNIPILE_WEBHOOK_SECRET=""

# ── Public reachability ───────────────────────────────────────────────────────
# Public https base URL for this app, no trailing slash. Required for Buffer to
# fetch post media and for Unipile to deliver webhooks. `npm run tunnel` prints
# one. Leave empty to run without either.
PUBLIC_APP_URL=""

# ── Optional ──────────────────────────────────────────────────────────────────
# Reveals the Google button on /auth. Requires [auth.external.google] to be
# configured in supabase/config.toml first.
VITE_ENABLE_GOOGLE_AUTH="false"

# Build target. Defaults to node-server; use cloudflare-module for Workers.
NITRO_PRESET="node-server"

# Platform-wide fallback keys for research tools (optional). Normally these are
# entered per workspace in Settings → Connections instead.
# FIRECRAWL_API_KEY=""
# SCRAPECREATORS_API_KEY=""
